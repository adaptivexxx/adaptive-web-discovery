    {"port": 3888, "role": "ZooKeeper leader election", "protocol": "tcp", "web": false},
    {"port": 8080, "role": "ZooKeeper AdminServer HTTP", "protocol": "http", "web": true, "scheme": "http"}
  ],
  "signatures": ["zookeeper", "mntr", "ruok"],
  "paths": ["commands", "commands/health", "commands/server_stats"],
