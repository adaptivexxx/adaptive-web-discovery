{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/web-discovery-playbook.schema.json",
  "title": "Web Discovery Technology Playbook",
  "type": "object",
  "required": [
    "schema_version",
    "id",
    "name",
    "category",
    "risk",
    "explicit_only",
    "protocols",
    "typical_ports",
    "signatures",
    "paths",
    "automatic_actions",
    "follow_up",
    "stop_conditions"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
    "name": {"type": "string", "minLength": 1},
    "category": {"type": "string", "minLength": 1},
    "description": {"type": "string"},
    "risk": {"enum": ["informational", "low", "medium", "high", "critical"]},
    "explicit_only": {"type": "boolean"},
    "protocols": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "typical_ports": {
      "type": "array",
      "items": {"type": "integer", "minimum": 1, "maximum": 65535},
      "uniqueItems": true
    },
    "port_hints": {"type": "array", "items": {"type": "object"}},
    "port_ranges": {"type": "array", "items": {"type": "object"}},
    "signatures": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "paths": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "automatic_actions": {"type": "array", "items": {"type": "string"}},
    "follow_up": {"type": "array", "items": {"type": "string"}},
    "stop_conditions": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": true
}
